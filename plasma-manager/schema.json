{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URL to the JSON schema"
    },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "write"
              },
              "file": {
                "type": "string",
                "description": "KDE configuration file name"
              },
              "group": {
                "type": "string",
                "description": "INI file group/section name"
              },
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "xdg_directory": {
                "type": "string",
                "enum": [
                  "config",
                  "data",
                  "cache",
                  "state"
                ],
                "description": "XDG directory where the file is located"
              },
              "immutable": {
                "type": "boolean"
              },
              "expand_environment": {
                "type": "boolean"
              }
            },
            "required": [
              "operation",
              "file",
              "xdg_directory"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "read"
              },
              "file": {
                "type": "string",
                "description": "KDE configuration file name"
              },
              "group": {
                "type": "string",
                "description": "INI file group/section name"
              },
              "key": {
                "type": "string"
              },
              "xdg_directory": {
                "type": "string",
                "enum": [
                  "config",
                  "data",
                  "cache",
                  "state"
                ],
                "description": "XDG directory where the file is located"
              },
              "raw": {
                "type": "boolean"
              }
            },
            "required": [
              "operation",
              "file",
              "xdg_directory"
            ]
          },
          {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "const": "delete"
              },
              "file": {
                "type": "string",
                "description": "KDE configuration file name"
              },
              "group": {
                "type": "string",
                "description": "INI file group/section name"
              },
              "key": {
                "type": "string"
              },
              "xdg_directory": {
                "type": "string",
                "enum": [
                  "config",
                  "data",
                  "cache",
                  "state"
                ],
                "description": "XDG directory where the file is located"
              }
            },
            "required": [
              "operation",
              "file",
              "xdg_directory"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "operations"
  ]
}
